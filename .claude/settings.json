{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-run.sh $CLAUDE_PROJECT_DIR/.claude/hooks/ai-commit-msg-ban.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-run.sh $CLAUDE_PROJECT_DIR/.claude/hooks/codex-review-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-run.sh $CLAUDE_PROJECT_DIR/.claude/hooks/no-env-commit.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-run.sh $CLAUDE_PROJECT_DIR/.claude/hooks/qa-gate-before-push.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-run.sh $CLAUDE_PROJECT_DIR/.claude/hooks/secret-content-scan.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-run.sh $CLAUDE_PROJECT_DIR/.claude/hooks/validate-before-commit.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-run.sh $CLAUDE_PROJECT_DIR/.claude/hooks/claim-done-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-run.sh $CLAUDE_PROJECT_DIR/.claude/hooks/deploy-verify-marker.sh"
          }
        ]
      }
    ]
  }
}